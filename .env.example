# Copy this file to .env.local (local dev) or add these to Vercel's environment
# variables dashboard (production). All vars below are REQUIRED for the app to work.

# ── Prisma / Neon ────────────────────────────────────────────────────────────

# Pooled connection (used at runtime by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DBNAME?sslmode=require"

# ── NextAuth / Auth.js ───────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
# On Vercel, do NOT set AUTH_URL / NEXTAUTH_URL — NextAuth auto-detects the
# production URL (trustHost: true is already set). Setting it to localhost
# here and accidentally pushing it to Vercel will break OAuth in production.
AUTH_SECRET="GENERATE_A_RANDOM_SECRET"

# NEXTAUTH_URL is only for local development:
# NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at github.com/settings/developers → New OAuth App
# Callback URL (local):  http://localhost:3000/api/auth/callback/github
# Callback URL (prod):   https://YOUR_DOMAIN/api/auth/callback/github
# Use separate OAuth Apps for local vs production if needed.

# Local dev
GITHUB_CLIENT_ID_LOCAL="your-local-github-client-id"
GITHUB_CLIENT_SECRET_LOCAL="your-local-github-client-secret"

# Production (set these in Vercel dashboard)
GITHUB_CLIENT_ID="your-prod-github-client-id"
GITHUB_CLIENT_SECRET="your-prod-github-client-secret"
