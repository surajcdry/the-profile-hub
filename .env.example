# Copy this file to .env and fill in your values.
# Get these from your Vercel Postgres (Neon) dashboard after creating a database.

# ── Prisma / Neon ────────────────────────────────────────────────────────────

# Pooled connection (used at runtime by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DBNAME?sslmode=require"
